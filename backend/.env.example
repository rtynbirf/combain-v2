# COMBAIN v2 backend — переменные окружения.
# Скопируйте в backend/.env (dev) или .env (docker compose) и заполните.

# Сеть
PORT=3000
HOST=0.0.0.0

# БЕЗОПАСНОСТЬ: обязательно сгенерируйте свой секрет — openssl rand -hex 32.
# В проде (NODE_ENV=production) сервер не стартует с дефолтным секретом.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_TTL_SECONDS=604800

# Пути и хранилище (в Docker: DATA_DIR=/data, UPLOAD_DIR=/data/uploads)
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
PUBLIC_DIR=../public

# Ограничения и прокси
RATE_LIMIT_MAX=600
TRUST_PROXY=false

# WebRTC STUN/TURN (JSON)
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
