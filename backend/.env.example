# COMBAIN v2 backend — переменные окружения.
# Скопируйте в backend/.env (dev) или .env (docker compose) и заполните.

# Сеть
PORT=3000
HOST=0.0.0.0

# БЕЗОПАСНОСТЬ: обязательно сгенерируйте свой секрет — openssl rand -hex 32.
# В проде (NODE_ENV=production) сервер не стартует с дефолтным секретом.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_TTL_SECONDS=604800

# Пути и хранилище (в Docker: DATA_DIR=/data, UPLOAD_DIR=/data/uploads)
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
PUBLIC_DIR=../public

# Ограничения и прокси
RATE_LIMIT_MAX=600
TRUST_PROXY=false

# Анти-брутфорс: неудачных попыток логина/регистрации на IP в минуту
# (успешные попытки не считаются)
AUTH_LIMIT_MAX=30

# WebSocket-хардненинг
ALLOWED_ORIGINS=
# ^ CSWSH-защита: перечислите origin через запятую (напр. https://chat.example.com).
#   Пусто = разрешены все (self-host за прокси).
WS_MAX_PAYLOAD=131072
# ^ Максимум байт на WS-фрейм; превышение — close 1009 (файлы идут через HTTP)
WS_MSG_LIMIT=60
# ^ Сообщений на соединение за скользящее окно 10с; превышение — close 4408

# Логи (winston): error|warn|info|http|debug. JSON в prod, pretty в dev.
LOG_LEVEL=http
# LOG_DIR=./data/logs
# LOG_SILENT=true   # выключить все транспорты (для тестов)

# WebRTC STUN/TURN (JSON)
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
