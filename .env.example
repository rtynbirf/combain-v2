# COMBAIN v2 — корневой .env для docker compose.
# Скопируйте: cp backend/.env.example .env  (этот файл — шаблон compose)

# ОБЯЗАТЕЛЬНО: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_TTL_SECONDS=604800

# Прокси и лимиты (приложение слушает 127.0.0.1:3000, наружу — через Caddy)
TRUST_PROXY=true
RATE_LIMIT_MAX=600
AUTH_LIMIT_MAX=30

# Загрузки
MAX_FILE_SIZE=52428800

# WebSocket-хардненинг (CSWSH): origin вашего сайта, напр. https://chat.example.com
ALLOWED_ORIGINS=
WS_MSG_LIMIT=60

# Логи
LOG_LEVEL=http

# WebRTC (JSON)
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# ── Профиль tls (Caddy) ─────────────────────────────────────────────
COMBAIN_DOMAIN=localhost

# ── Профиль backup (Litestream → S3-совместимое хранилище) ─────────
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
